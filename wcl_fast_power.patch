+#ifdef AIRPORT_WCL
+// A user power-off and system sleep only cut power to the card. A real Mac
+// does not report its driver unavailable for that, and airportd relies on it:
+// on POWER_CHANGED (power on) it auto-joins with trigger power_on only while
+// the driver is still "available". If the driver reports unavailable and then
+// available again, airportd treats power-on as a chip reset and, with the
+// screen unlocked, starts with an auto_instant_hotspot round instead.
+void AirportItlwm::quietDisableAdapter()
+{
+    auto ic = fHalService->get80211Controller();
+    ic->ic_wcl_quiet_stop = (ic->ic_wcl_fast & 1) != 0;
+    disableAdapter(bsdInterface);
+    // iwx_stop() reports DRIVER_STOPPED synchronously; do not leave the flag
+    // for a later, unrelated stop if the card was already down.
+    ic->ic_wcl_quiet_stop = false;
+}
+#endif
