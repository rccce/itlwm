diff --git a/itlwm/hal_iwx/ItlIwx.cpp b/itlwm/hal_iwx/ItlIwx.cpp
index f80e5cb..64a761b 100644
--- a/itlwm/hal_iwx/ItlIwx.cpp
+++ b/itlwm/hal_iwx/ItlIwx.cpp
@@ -9051,6 +9051,36 @@ iwx_scan_abort(struct iwx_softc *sc)
     return err;
 }
 
+#ifdef AIRPORT_WCL
+/*
+ * A join arrived while net80211 runs one of its own full scans (about 3.8 s
+ * on the AX210). Stop that scan now instead of waiting for it. Unlike
+ * iwx_scan_abort(), keep IWX_FLAG_SCANNING: the firmware answers the abort
+ * with SCAN_COMPLETE_UMAC, and iwx_endscan() then runs the normal
+ * ieee80211_end_scan(), which picks the requested BSS from the scan results.
+ * The abort is sent asynchronously so that the WCL join request returns
+ * before any of that happens.
+ */
+bool ItlIwx::
+endScanForJoin()
+{
+    struct iwx_softc *sc = &com;
+    struct ieee80211com *ic = &sc->sc_ic;
+    struct iwx_umac_scan_abort cmd = { 0 };
+    int err;
+
+    if (ic->ic_state != IEEE80211_S_SCAN ||
+        (sc->sc_flags & (IWX_FLAG_SCANNING | IWX_FLAG_BGSCAN)) != IWX_FLAG_SCANNING)
+        return false;
+    /* The end of this scan must not count as the join's own scan. */
+    ic->ic_wcl_join_scan_skip = 1;
+    err = iwx_send_cmd_pdu(sc, IWX_WIDE_ID(IWX_LONG_GROUP, IWX_SCAN_ABORT_UMAC),
+                           IWX_CMD_ASYNC, sizeof(cmd), &cmd);
+    XYLog("wcl: ending scan early for join, error %d\n", err);
+    return true;
+}
+#endif
