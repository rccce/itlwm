+#ifdef AIRPORT_WCL
+// A user power-off only cuts power to the card. A real Mac does not report
+// its driver unavailable for that, and airportd relies on it: on
+// POWER_CHANGED (power on) it auto-joins with trigger power_on only while the
+// driver is still "available". If the driver reports unavailable and then
+// available again, airportd treats power-on as a chip reset and, with the
+// screen unlocked, starts with an auto_instant_hotspot round instead.
+// System sleep is not quiet. The 1st version of this change made sleep quiet
+// too, and the tester's Mac then woke again 1-2 s after going to sleep; sleep
+// and wake now report the driver unavailable and available as 7204c69 does.
+void AirportItlwm::quietDisableAdapter()
+{
+    auto ic = fHalService->get80211Controller();
+    ic->ic_wcl_quiet_stop = (ic->ic_wcl_fast & 1) != 0 && !wclSystemSleep;
+    if (wclSystemSleep && (ic->ic_ac.ac_if.if_flags & IFF_UP))
+        XYLog("wcl: system sleep, Wi-Fi stops as in 7204c69\n");
+    disableAdapter(bsdInterface);
+    // iwx_stop() reports DRIVER_STOPPED synchronously; do not leave the flag
+    // for a later, unrelated stop if the card was already down.
+    ic->ic_wcl_quiet_stop = false;
+}
+
+// Priority sleep/wake interest: kIOMessageSystemWillSleep arrives after the
+// applications (airportd) and before any driver's setPowerState, and
+// kIOMessageSystemWillPowerOn before the drivers power on again.
+IOReturn AirportItlwm::wclSleepWakeHandler(void *target, void *, UInt32 messageType,
+                                           IOService *, void *, vm_size_t)
+{
+    AirportItlwm *that = static_cast<AirportItlwm *>(target);
+    if (!that)
+        return kIOReturnSuccess;
+    switch (messageType) {
+        case kIOMessageSystemWillSleep:
+            that->wclSystemSleep = true;
+            // Wi-Fi switched off quietly before: report the driver
+            // unavailable now, as 7204c69 did at the power-off itself.
+            if (that->fNetIf)
+                static_cast<AirportItlwmSkywalkInterface *>(that->fNetIf)->wclSystemWillSleep();
+            break;
+        case kIOMessageSystemWillPowerOn:
+        case kIOMessageSystemHasPoweredOn:
+            that->wclSystemSleep = false;
+            break;
+        default:
+            break;
+    }
+    return kIOReturnSuccess;
+}
+#endif
+
