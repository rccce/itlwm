+// Primary 20 MHz channel of a native channel spec, the same encoding this
+// driver uses for scan results: channel (centre channel above 20 MHz) in bits
+// 0-7, control sideband in bits 8-10, bandwidth in bits 11-13 (0x1000 20 MHz,
+// 0x1800 40, 0x2000 80, 0x2800 160) and band in bits 14-15 (0 for 2.4 GHz,
+// 0xc000 for 5 GHz). Returns 0 for anything else, so callers fall back to a
+// full scan.
+inline unsigned primaryChannelFromSpec(uint16_t spec) {
+    int channel = spec & 0xff, sideband = (spec >> 8) & 7, primary;
+    switch (spec & 0x3800) {
+        case 0x1000: primary = sideband ? 0 : channel; break;
+        case 0x1800: primary = sideband > 1 ? 0 : channel + (sideband ? 2 : -2); break;
+        case 0x2000: primary = sideband > 3 ? 0 : channel - 6 + 4 * sideband; break;
+        case 0x2800: primary = channel - 14 + 4 * sideband; break;
+        default: return 0;
+    }
+    if (primary < 1 || primary > 196)
+        return 0;
+    if ((spec & 0xc000) == 0xc000 ? primary <= 14 : ((spec & 0xc000) != 0 || primary > 14))
+        return 0;
+    return unsigned(primary);
+}
