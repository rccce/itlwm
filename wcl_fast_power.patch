+bool AirportItlwmSkywalkInterface::armJoinScan(uint16_t channelSpec, const uint8_t *ssid, uint32_t ssidLength)
+{
+    ieee80211com *ic = fHalService->get80211Controller();
+    unsigned channel = AirportWCL::primaryChannelFromSpec(channelSpec);
+    // WCL scans cannot be pending while a join is (both return Busy), so the
+    // ic_wcl_scan_* fields are free; check anyway.
+    if (!(ic->ic_wcl_fast & 4) || scanPending || !channel ||
+        channel > IEEE80211_CHAN_MAX || !ic->ic_channels[channel].ic_flags ||
+        ssidLength > sizeof(ic->ic_wcl_scan_ssid))
+        return false;
+    if (!wclJoinScan) {
+        ic->ic_wcl_join_scan_skip = 0;
+        XYLog("wcl: join scan on channel %u (spec 0x%04x)\n", channel, channelSpec);
+    }
+    bzero(ic->ic_wcl_scan_channels, sizeof(ic->ic_wcl_scan_channels));
+    ic->ic_wcl_scan_channels[channel / 8] |= 1U << (channel % 8);
+    ic->ic_wcl_scan_restricted = true;
+    ic->ic_wcl_scan_active = true;
+    bzero(ic->ic_wcl_scan_ssid, sizeof(ic->ic_wcl_scan_ssid));
+    memcpy(ic->ic_wcl_scan_ssid, ssid, ssidLength);
+    ic->ic_wcl_scan_ssid_length = uint8_t(ssidLength);
+    ic->ic_wcl_scan_requested = true;
+    wclJoinScan = true;
+    return true;
+}
+
+void AirportItlwmSkywalkInterface::disarmJoinScan()
+{
+    if (!wclJoinScan)
+        return;
+    wclJoinScan = false;
+    ieee80211com *ic = fHalService->get80211Controller();
+    ic->ic_wcl_join_scan_skip = 0;
+    if (scanPending)
+        return;
+    ic->ic_wcl_scan_requested = false;
+    ic->ic_wcl_scan_restricted = false;
+    ic->ic_wcl_scan_active = false;
+    ic->ic_wcl_scan_ssid_length = 0;
+}
+
+// Called by the priority sleep/wake handler on the power management thread.
+// Take the gate only when Wi-Fi is quietly off (rare); the flag is
+// re-checked under the gate.
+void AirportItlwmSkywalkInterface::wclSystemWillSleep()
+{
+    if (wclQuietDown && _fCommandGate)
+        _fCommandGate->runAction(wclCommand, this, reinterpret_cast<void *>(16));
+}
+
+// System sleep while Wi-Fi is quietly off: report the driver unavailable now,
+// so that sleep and wake see the same state as with 7204c69, where the
+// power-off itself reported it. The next power-on is then a reset again.
+void AirportItlwmSkywalkInterface::reportQuietDownForSleep()
+{
+    if (!wclQuietDown)
+        return;
+    wclQuietDown = false;
+    XYLog("wcl: system sleep while Wi-Fi is off, reporting the driver unavailable\n");
+    AirportWCL::DriverAvailability event = {};
+    event.version = 3;
+    event.available = 0;
+    event.reason = 0xe0821804;
+    instance->postMessage(this, AirportWCL::DriverAvailable, &event, sizeof(event), true);
+}
